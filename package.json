{
  "name": "ously-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo type-check",
    "storybook": "turbo dev --filter=storybook",
    "check-precommit": "pnpm format && pnpm lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "next": "16.2.4",
    "prettier": "^3.0.0",
    "shadcn": "^4.6.0",
    "turbo": "^2.7.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"],
    "overrides": {
      "webpack": "^5.91.0",
      "vite-plugin-storybook-nextjs": "^3.2.4"
    }
  }
}
