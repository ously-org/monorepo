# ============================================
# Google OAuth Credentials
# ============================================
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID (Web application)
# 3. Add "http://localhost:8787/api/auth/callback/google" as an Authorized redirect URI
# 4. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ============================================
# Better Auth Configuration
# ============================================
# The base URL where the API is running (used for OAuth callbacks)
BETTER_AUTH_URL=http://localhost:8787

# Secret key for session encryption/hashing (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-generated-secret-here-min-32-chars
